<script src="{{ 'animated-auth.js' | asset_url }}" type="module" defer></script>

{% stylesheet %}
  .animated-auth {
    --aa-border: #333333;
    --aa-muted: #888888;
    --aa-footer-muted: #666666;
    --aa-input-bg: #000000;
    --aa-radius: 6px;
    --aa-radius-lg: 12px;

    position: relative;
    width: 100%;
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: var(--aa-bg, #000000);
    color: #ffffff;
  }

  .animated-auth__background {
    position: absolute;
    inset: 0;
    z-index: 0;
    display: block;
  }

  .animated-auth__canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  .animated-auth__vignette {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: radial-gradient(circle at center, rgba(0, 0, 0, 0.75) 0%, rgba(0, 0, 0, 0) 100%);
    pointer-events: none;
  }

  .animated-auth__card {
    position: relative;
    z-index: 2;
    background: var(--aa-card-bg, #121212);
    border: 1px solid var(--aa-border);
    border-radius: var(--aa-radius-lg);
    padding: 2rem;
    width: 100%;
    max-width: 400px;
    margin: 0 1rem;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.8);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .animated-auth__panel {
    width: 100%;
    max-width: 360px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .animated-auth__card[data-mode='signin'] .animated-auth__panel--signup,
  .animated-auth__card[data-mode='signup'] .animated-auth__panel--signin {
    display: none;
  }

  .animated-auth__logo {
    background: #111111;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 1.15rem;
    margin-bottom: 0.75rem;
    border: 1px solid var(--aa-border);
  }

  .animated-auth__title {
    font-size: 1.35rem;
    font-weight: 600;
    margin-bottom: 0.25rem;
    letter-spacing: -0.025em;
  }

  .animated-auth__subtitle {
    font-size: 0.85rem;
    color: var(--aa-muted);
    margin-bottom: 0.85rem;
    line-height: 1.5;
  }

  .animated-auth__form {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .animated-auth__input {
    width: 100%;
    padding: 0.65rem 0.85rem;
    border-radius: var(--aa-radius);
    border: 1px solid var(--aa-border);
    background: var(--aa-input-bg);
    color: #ffffff;
    font-size: 0.875rem;
    outline: none;
    font-family: inherit;
  }

  .animated-auth__submit {
    width: 100%;
    padding: 0.65rem;
    border-radius: var(--aa-radius);
    border: none;
    background: var(--aa-button-bg, #ededed);
    color: #000000;
    font-weight: 500;
    font-size: 0.875rem;
    cursor: pointer;
    text-decoration: none;
    display: block;
    text-align: center;
    font-family: inherit;
  }

  .animated-auth__divider {
    height: 1px;
    background: var(--aa-border);
    width: 100%;
    margin: 0.85rem 0;
  }

  .animated-auth__social {
    width: 100%;
    padding: 0.65rem;
    border-radius: var(--aa-radius);
    border: 1px solid var(--aa-border);
    background: transparent;
    color: #ffffff;
    font-weight: 500;
    font-size: 0.875rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-bottom: 0.4rem;
    text-decoration: none;
    font-family: inherit;
  }

  .animated-auth__social svg {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  .animated-auth__switch {
    margin-top: 1.25rem;
    font-size: 0.875rem;
    color: var(--aa-muted);
  }

  .animated-auth__switch-btn {
    color: #ffffff;
    font-weight: 500;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    font-family: inherit;
    font-size: inherit;
    text-decoration: underline;
  }

  .animated-auth__footer {
    margin-top: 0.85rem;
    font-size: 0.75rem;
    color: var(--aa-footer-muted);
    line-height: 1.5;
    text-align: center;
  }

  .animated-auth__footer a {
    color: var(--aa-muted);
  }

  @media (max-width: 480px) {
    .animated-auth__card {
      padding: 1.5rem;
    }
  }
{% endstylesheet %}

{% liquid
  assign logo_text = section.settings.logo_text
  if logo_text == blank
    assign logo_text = shop.name | slice: 0, 2 | upcase
  endif
%}
{% capture auth_footer %}<div class="animated-auth__footer">{{ section.settings.footer_text }}</div>{% endcapture %}

<div class="animated-auth" style="--aa-bg: {{ section.settings.bg_color }}; --aa-card-bg: {{ section.settings.card_color }}; --aa-button-bg: {{ section.settings.button_color }};">
  {% if section.settings.show_dot_grid %}
    <animated-auth-background class="animated-auth__background" data-three-src="{{ 'three.min.js' | asset_url }}">
      <canvas class="animated-auth__canvas"></canvas>
    </animated-auth-background>
  {% endif %}

  <div class="animated-auth__vignette"></div>

  <auth-toggle-card class="animated-auth__card" data-mode="signin">
    {%- comment -%} Sign in panel {%- endcomment -%}
    <div class="animated-auth__panel animated-auth__panel--signin">
      <div class="animated-auth__logo">{{ logo_text }}</div>
      <h1 class="animated-auth__title">{{ section.settings.signin_heading }}</h1>
      <p class="animated-auth__subtitle">{{ section.settings.signin_subheading }}</p>

      <form class="animated-auth__form" action="{{ routes.account_login_url }}" method="get">
        <input class="animated-auth__input" type="email" name="email" placeholder="name@work-email.com" required>
        <button type="submit" class="animated-auth__submit">Continue with Email</button>
      </form>

      <div class="animated-auth__divider"></div>

      {% if section.settings.show_google and section.settings.google_url != blank %}
        <a href="{{ section.settings.google_url }}" class="animated-auth__social">
          <svg viewBox="0 0 24 24"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg>
          Continue with Google
        </a>
      {% endif %}
      {% if section.settings.show_github and section.settings.github_url != blank %}
        <a href="{{ section.settings.github_url }}" class="animated-auth__social">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.699-2.782.603-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.462-1.11-1.462-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.831.092-.646.35-1.086.636-1.336-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0112 6.836c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.379.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.577.688.48C19.138 20.161 22 16.416 22 12c0-5.523-4.477-10-10-10z"/></svg>
          Continue with GitHub
        </a>
      {% endif %}
      {% if section.settings.show_apple and section.settings.apple_url != blank %}
        <a href="{{ section.settings.apple_url }}" class="animated-auth__social">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.04 2.26-.79 3.59-.76 1.56.04 2.88.75 3.65 1.89-3.08 1.75-2.58 5.61.35 6.75-1.01 2.37-2.39 4.39-4.29 4.29zM12.03 7.25c-.15-2.23 1.66-4.07 3.72-4.25.36 2.38-1.92 4.34-3.72 4.25z"/></svg>
          Continue with Apple
        </a>
      {% endif %}

      <div class="animated-auth__switch">
        Don&rsquo;t have an account?
        <button type="button" class="animated-auth__switch-btn" data-auth-switch="signup">Sign Up</button>
      </div>

      {{ auth_footer }}
    </div>

    {%- comment -%} Sign up panel {%- endcomment -%}
    <div class="animated-auth__panel animated-auth__panel--signup">
      <div class="animated-auth__logo">{{ logo_text }}</div>
      <h1 class="animated-auth__title">{{ section.settings.signup_heading }}</h1>
      <p class="animated-auth__subtitle">{{ section.settings.signup_subheading }}</p>

      <form class="animated-auth__form" action="{{ routes.account_register_url }}" method="get">
        <input class="animated-auth__input" type="text" name="name" placeholder="Full Name" required>
        <input class="animated-auth__input" type="email" name="email" placeholder="name@work-email.com" required>
        <button type="submit" class="animated-auth__submit">Sign Up with Email</button>
      </form>

      <div class="animated-auth__divider"></div>

      {% if section.settings.show_google and section.settings.google_url != blank %}
        <a href="{{ section.settings.google_url }}" class="animated-auth__social">
          <svg viewBox="0 0 24 24"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg>
          Sign up with Google
        </a>
      {% endif %}
      {% if section.settings.show_github and section.settings.github_url != blank %}
        <a href="{{ section.settings.github_url }}" class="animated-auth__social">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.699-2.782.603-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.462-1.11-1.462-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.831.092-.646.35-1.086.636-1.336-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0112 6.836c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.379.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.577.688.48C19.138 20.161 22 16.416 22 12c0-5.523-4.477-10-10-10z"/></svg>
          Sign up with GitHub
        </a>
      {% endif %}
      {% if section.settings.show_apple and section.settings.apple_url != blank %}
        <a href="{{ section.settings.apple_url }}" class="animated-auth__social">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.04 2.26-.79 3.59-.76 1.56.04 2.88.75 3.65 1.89-3.08 1.75-2.58 5.61.35 6.75-1.01 2.37-2.39 4.39-4.29 4.29zM12.03 7.25c-.15-2.23 1.66-4.07 3.72-4.25.36 2.38-1.92 4.34-3.72 4.25z"/></svg>
          Sign up with Apple
        </a>
      {% endif %}

      <div class="animated-auth__switch">
        Already have an account?
        <button type="button" class="animated-auth__switch-btn" data-auth-switch="signin">Sign In</button>
      </div>

      {{ auth_footer }}
    </div>
  </auth-toggle-card>
</div>

{% schema %}
{
  "name": "Animated sign in/up",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "logo_text", "label": "Logo initials", "info": "Leave blank to use the first two letters of your store name.", "default": "" },
    { "type": "text", "id": "signin_heading", "label": "Sign in heading", "default": "Sign in to Account" },
    { "type": "text", "id": "signin_subheading", "label": "Sign in subheading", "default": "Sign in to your Account." },
    { "type": "text", "id": "signup_heading", "label": "Sign up heading", "default": "Sign up for Account" },
    { "type": "text", "id": "signup_subheading", "label": "Sign up subheading", "default": "Create a new account to get started." },
    { "type": "richtext", "id": "footer_text", "label": "Footer legal text", "default": "<p>By proceeding, you agree to our Terms of Service and Privacy Policy.</p>" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color", "label": "Page background", "default": "#000000" },
    { "type": "color", "id": "card_color", "label": "Card background", "default": "#121212" },
    { "type": "color", "id": "button_color", "label": "Button background", "default": "#ededed" },
    { "type": "header", "content": "Animated background" },
    { "type": "checkbox", "id": "show_dot_grid", "label": "Show animated dot-grid background", "default": true, "info": "Automatically skipped for visitors who have 'reduce motion' enabled in their OS." },
    { "type": "header", "content": "Social sign-in buttons" },
    { "type": "paragraph", "content": "Shopify accounts don't support Google/GitHub/Apple sign-in natively. Only enable a button if you've installed a social-login app and have its direct sign-in URL - otherwise it stays hidden." },
    { "type": "checkbox", "id": "show_google", "label": "Show Google button", "default": false },
    { "type": "url", "id": "google_url", "label": "Google sign-in URL" },
    { "type": "checkbox", "id": "show_github", "label": "Show GitHub button", "default": false },
    { "type": "url", "id": "github_url", "label": "GitHub sign-in URL" },
    { "type": "checkbox", "id": "show_apple", "label": "Show Apple button", "default": false },
    { "type": "url", "id": "apple_url", "label": "Apple sign-in URL" }
  ],
  "presets": [
    { "name": "Animated sign in/up" }
  ]
}
{% endschema %}
